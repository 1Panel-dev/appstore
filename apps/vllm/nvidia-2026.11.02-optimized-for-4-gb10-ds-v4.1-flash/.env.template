# Cluster configuration for the DeepSeek-V4.1-Flash appliance.
#
# Copy this file to .env, then fill in the four node addresses and interfaces.
# Normally you do not edit this file directly: prep/configure-fabric.sh copies
# it to .env and updates the topology block below, preserving CONTAINER_*.
# setup-cluster.sh is run with --no-env so it does not overwrite these values.
#
# The first CLUSTER_NODES entry is the head node. All four entries must be
# reachable over passwordless SSH from the head node.

# --- Cluster topology -------------------------------------------------------
# The first entry is the head. These are the CX7 high-speed addresses, not the
# management network. prep/configure-fabric.sh writes/updates this block.
CLUSTER_NODES="10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4"
COPY_HOSTS="10.0.1.2,10.0.1.3,10.0.1.4"
LOCAL_IP="10.0.1.1"

# All four Sparks must use the same physical CX7 port position.
# Port 0 is enp1s0f0np0 (inner/left QSFP cage); port 1 is enp1s0f1np1
# (outer/right cage). Verify the cabled port with: ibdev2netdev
ETH_IF="enp1s0f0np0"
# One physical CX7 port exposes TWO RoCE twins, each PCIe x4 (about 100G).
# NCCL must use both twins to reach the full 200G; listing only rocep1s0f0
# silently caps RDMA at about 100G. Keep both names.
# configure-fabric.sh also gives the second twin its own address in a SEPARATE
# subnet (default 10.0.2.1-10.0.2.4/24, derived from the fabric host number);
# RoCE needs an address on each twin. Only the primary addresses appear in
# CLUSTER_NODES/COPY_HOSTS/LOCAL_IP.
IB_IF="rocep1s0f0,roceP2p1s0f0"

MASTER_PORT="29501"
CONTAINER_NAME="vllm_node"

# --- vLLM / B12X / DSpark runtime environment -------------------------------
# CONTAINER_<NAME>=<value> is passed to every container as -e <NAME>=<value>.
CONTAINER_VLLM_ENABLE_ROCE_ALLREDUCE="1"
CONTAINER_VLLM_ROCE_ALLREDUCE_MAX_SIZE="2MB"
CONTAINER_B12X_COMPILE_WORKERS="4"
CONTAINER_CUTE_DSL_ARCH="sm_121a"
CONTAINER_VLLM_USE_V2_MODEL_RUNNER="1"
CONTAINER_VLLM_USE_BREAKABLE_CUDAGRAPH="1"
CONTAINER_VLLM_MXFP8_LM_HEAD="1"

# Weights are mounted from /opt/1panel/ai/models; do not reach out to HF.
CONTAINER_HF_HUB_OFFLINE="1"
CONTAINER_TRANSFORMERS_OFFLINE="1"

# Optional diagnostics. For the first boot, INFO shows which RoCE devices NCCL
# selected (expect both rocep1s0f0 and roceP2p1s0f0); switch back to WARN later.
# CONTAINER_NCCL_DEBUG="INFO"
