CONTAINER_NAME=1panel-vllm-gb10-dspark
PANEL_APP_PORT_HTTP=8000
IMAGE_PULL_POLICY=if_not_present

WORKER_HOST=10.0.1.2
WORKER_DIR=/opt/1pds
WORKER_SCRIPT_DIR=/opt/1pds
MASTER_ADDR=10.0.1.1
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

NCCL_IB_HCA=rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
WORKER_NCCL_IB_HCA=rocep1s0f0
WORKER_NCCL_SOCKET_IFNAME=enp1s0f0np0
WORKER_TP_SOCKET_IFNAME=enp1s0f0np0
WORKER_GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_AUTO=1
NCCL_CROSS_NIC=1

HF_CACHE=/opt/1pds/cache
WORKER_HF_CACHE=/opt/1pds/cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

ABLITERATED=0
DSPARK_MODEL_HOST=/opt/1panel/ai/DeepSeek-V4-Flash-0731
DSPARK_MODEL_CONTAINER=/models
DSPARK_REVISION=
DSPARK_ENCODING_FILE=/models/encoding/encoding_dsv4.py
SERVED_MODEL_NAME=DeepSeek-V4-Flash
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_API_KEY=
DSPARK_API_KEYS=
VLLM_HOST_IP=10.0.1.1
WORKER_VLLM_HOST_IP=10.0.1.2

DSPARK_VLLM_IMAGE=1panel/vllm-gb10-dspark:0.1.1
DSPARK_RESTART_POLICY=unless-stopped
DSPARK_STOP_GRACE=10s

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
DSPARK_MAX_INFLIGHT_PREFILLS=2
DSPARK_ISSUE43_SCHED_DIAG=0
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=4096
GPU_MEMORY_UTILIZATION_TEXT=0.80
GPU_MEMORY_UTILIZATION_VISION=0.80
MTP_NUM_TOKENS=5
DRAFT_SAMPLE_METHOD=probabilistic
DEFAULT_THINKING=low

DSPARK_ENABLE_ASSISTANT_FINAL_HOTFIX=0
DSPARK_ENABLE_ISSUE31_GPU_HOTFIX=0
DSPARK_SUPPRESS_STOPS_IN_REASONING=1

VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800

CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
FLASHINFER_WORKSPACE_BASE=/cache/huggingface/flashinfer
TILELANG_CLEANUP_TEMP_FILES=1
TILELANG_CACHE_DIR=/cache/huggingface/tilelang-cache
TRITON_CACHE_DIR=/cache/huggingface/triton-cache
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc

NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

ENABLE_VLLM_GB10_PATCH=0
ENABLE_VL_SIDECAR=0
PREPARE_VL_SIDECAR_MODEL=0
DSPARK_BOOT_SHAPE_WARMUP=1
DSPARK_WARMUP_REQ_TIMEOUT=240
