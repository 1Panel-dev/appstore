install_extension_safely() (
    local extension=$1
    local installer=$2
    local stage main_ini file target
    local status=0
    # Keep pending configuration on the same filesystem so it can be published without overwriting live files.
    stage=$(mktemp -d "$config_dir/.install-ext.XXXXXXXX") || return 2
    trap 'rm -rf -- "$stage"' EXIT
    mkdir "$stage/conf.d" || return 2
    main_ini=$(php -d display_errors=stderr -r 'echo php_ini_loaded_file();') || return 2
    if [ -n "$main_ini" ]; then
        cp -p -- "$main_ini" "$stage/php.ini" || return 2
    fi

    export PHPRC="$stage" PHP_INI_DIR="$stage"
    export PHP_INI_SCAN_DIR="${PHP_INI_SCAN_DIR-$config_dir}:$stage/conf.d"
    ERROR_CODE=0
    "$installer" "$extension" || status=$?
    if [[ "$extension" =~ ^[[:alnum:]_]+$ ]]; then
        if ! is_extension_installed "$extension" >/dev/null; then
            status=1
        fi
    fi
    if [ "$status" -ne 0 ] || [ "$ERROR_CODE" -ne 0 ]; then
        echo "------ install extension $extension failed ------"
        return 1
    fi

    shopt -s nullglob
    local staged_files=("$stage/conf.d/"*)
    for file in "${staged_files[@]}"; do
        target="$config_dir/${file##*/}"
        [[ -f "$file" && ! -L "$file" ]] || return 2
        # Some extensions reference a companion rules file in their ini.
        if [[ "$file" == *.ini ]] && grep -Fq -- "$stage/conf.d/" "$file"; then
            php -n -r '$s=file_get_contents($argv[1]); exit($s === false || file_put_contents($argv[1],str_replace($argv[2],$argv[3],$s)) === false ? 1 : 0);' -- "$file" "$stage/conf.d/" "$config_dir/" || return 2
        fi
        if [[ -e "$target" || -L "$target" ]]; then
            if ! cmp -s -- "$file" "$target"; then
                printf 'PHP configuration already exists: %s\n' "$target" >&2
                return 1
            fi
        fi
    done
    for file in "${staged_files[@]}"; do
        target="$config_dir/${file##*/}"
        ln -T -- "$file" "$target" 2>/dev/null || cmp -s -- "$file" "$target" || return 2
    done
    return 0
)

install_extension_list() {
    local extension_list=$1
    local extension installer status
    local has_redis=0
    local has_igbinary=0
    local has_msgpack=0
    local extension_array=()
    local extensions=()
    local remaining_extensions=()

    IFS=',' read -r -a extension_array <<< "$extension_list"

    for extension in "${extension_array[@]}"; do
        extension=$(trim_extension "$extension")
        if [ -z "$extension" ]; then
            continue
        fi

        extensions+=("$extension")
        case "$extension" in
            redis)
                has_redis=1
                ;;
            msgpack)
                has_msgpack=1
                ;;
            igbinary)
                has_igbinary=1
                ;;
            *)
                remaining_extensions+=("$extension")
                ;;
        esac
    done

    if [ $has_redis -eq 1 ]; then
        # The installer enables Redis serializers based on the modules PHP has loaded.
        extensions=("${remaining_extensions[@]}")
        [ "$has_igbinary" -eq 0 ] || extensions+=(igbinary)
        [ "$has_msgpack" -eq 0 ] || extensions+=(msgpack)
        extensions+=(redis)
    fi

    for extension in "${extensions[@]}"; do
        if [[ "$extension" == -* ]]; then
            failed_extensions+=("$extension")
            continue
        fi
        if is_extension_installed "$extension"; then
            continue
        fi
        installer=install_extension
        if [ "$has_redis" -eq 1 ] && [[ "$extension" == igbinary || "$extension" == msgpack ]]; then
            installer=install_php_extensions
        fi
        status=0
        install_extension_safely "$extension" "$installer" || status=$?
        case "$status" in
            0) ;;
            1) failed_extensions+=("$extension") ;;
            *) return "$status" ;;
        esac
    done
}

failed_extensions=()
install_extension_list "$1" || exit 1
docker-php-source delete || exit 1

if [ "${#failed_extensions[@]}" -eq 0 ]; then
    exit 0
fi

printf 'Failed PHP extensions: %s\n' "${failed_extensions[*]}"
if [ "${2:-}" != "--allow-partial" ]; then
    exit 1
fi

# Older panels and manual installs still receive a failure exit status unless they opt in.
failures=$(php -n -r '$json = json_encode(array_slice($argv, 1)); if ($json === false) { exit(1); } echo $json;' -- "${failed_extensions[@]}") || exit 1
printf '1PANEL_PHP_EXTENSION_FAILURES=%s\n' "$failures"
